NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/movie_booking
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:4200

# Redis — seat locks (MongoDB remains source of truth for reservations)
REDIS_URL=redis://127.0.0.1:6379
HOLD_MINUTES=8
HOLD_EXPIRY_POLL_MS=30000

# Razorpay (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional notification settings. Console fallback is used when missing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMS_PROVIDER=dummy
