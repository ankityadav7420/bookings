NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/movie_booking
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:4200

# Dummy Razorpay keys for local development.
RAZORPAY_KEY_ID=
